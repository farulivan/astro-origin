---
import { siteConfig } from "@/config/site"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

import LanguagePicker from "./LanguagePicker.astro"
import ThemeToggle from "./ThemeToggle.astro"
import Container from "./ui/Container.astro"
import Icon from "./ui/Icon.astro"

interface Props {
  lang: Locale
  /** Locale-less path of the current page. */
  path: string
}

const { lang, path } = Astro.props
const t = useTranslations(lang)

/**
 * Nav hrefs are authored locale-less in site.ts and localized here, so adding
 * a language never means editing the navigation.
 */
const items = siteConfig.nav.map((item) => ({
  label: t(item.key),
  href: localizePath(item.href, lang),
}))
---

<header
  class="border-border bg-background/85 sticky top-0 z-40 border-b backdrop-blur"
>
  <Container class="flex h-16 items-center gap-4">
    <a
      href={localizePath("/", lang)}
      class="flex items-center gap-2 font-semibold tracking-tight"
    >
      <span
        class="bg-primary text-primary-foreground flex size-7 items-center justify-center rounded-md"
        aria-hidden="true"
      >
        <Icon name="zap" class="size-4" />
      </span>
      {siteConfig.name}
    </a>

    <nav aria-label={t("nav.main")} class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-muted-foreground hover:bg-accent hover:text-accent-foreground rounded-md px-3 py-2 text-sm transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 md:ml-0">
      <LanguagePicker lang={lang} path={path} class="hidden sm:flex" />
      <ThemeToggle lang={lang} />
      <button
        type="button"
        id="nav-toggle"
        class="text-muted-foreground hover:bg-accent hover:text-accent-foreground inline-flex size-9 items-center justify-center rounded-md transition-colors md:hidden"
        aria-label={t("nav.openMenu")}
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-label-open={t("nav.openMenu")}
        data-label-close={t("nav.closeMenu")}
      >
        <Icon name="menu" class="size-5" data-nav-icon="closed" />
        <Icon name="close" class="size-5" data-nav-icon="open" />
      </button>
    </div>
  </Container>

  <div id="mobile-nav" class="border-border border-t md:hidden" hidden>
    <Container class="py-3">
      <nav aria-label={t("nav.main")}>
        <ul class="grid gap-1">
          {
            items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-muted-foreground hover:bg-accent hover:text-accent-foreground block rounded-md px-3 py-2 text-sm transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <LanguagePicker lang={lang} path={path} class="mt-3 sm:hidden" />
    </Container>
  </div>
</header>

<style>
  [data-nav-icon="open"] {
    display: none;
  }
  button[aria-expanded="true"] [data-nav-icon="open"] {
    display: block;
  }
  button[aria-expanded="true"] [data-nav-icon="closed"] {
    display: none;
  }
</style>

<script>
  function setUp() {
    const toggle = document.getElementById("nav-toggle")
    const panel = document.getElementById("mobile-nav")
    if (!toggle || !panel) return

    toggle.addEventListener("click", () => {
      const willOpen = toggle.getAttribute("aria-expanded") !== "true"
      toggle.setAttribute("aria-expanded", String(willOpen))
      // `hidden` rather than a display class: it keeps the panel out of the
      // accessibility tree and out of the tab order while closed.
      panel.hidden = !willOpen
      toggle.setAttribute(
        "aria-label",
        (willOpen ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? ""
      )
    })
  }

  setUp()
  document.addEventListener("astro:after-swap", setUp)
</script>

---
import { cn } from "@/lib/utils"

/**
 * Centered page gutter.
 *
 * The prop is `tag`, not `as`, and this is not a style preference. Astro
 * 7.2.10 has two related problems with `as` here: a non-generic Props
 * interface containing an `as` key stops Astro binding Props at all (it is a
 * TypeScript keyword), and the documented generic `Polymorphic<{ as: Tag }>`
 * form breaks Props binding in the components that consume it. Both failures
 * surface far away, as implicit-any errors in unrelated files, so they cost
 * far more to diagnose than the passthrough typing would have bought.
 *
 * If a caller ever needs an attribute this does not forward, add it here
 * rather than reaching for Polymorphic again.
 */
interface Props {
  tag?: "div" | "section" | "header" | "footer" | "main" | "nav"
  class?: string
  id?: string
  "aria-label"?: string
  "aria-labelledby"?: string
}

const { tag: Tag = "div", class: className, ...rest } = Astro.props
---

<Tag
  class={cn("mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8", className)}
  {...rest}
>
  <slot />
</Tag>

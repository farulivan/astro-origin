---
import { cn } from "@/lib/utils"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!--
  Tailwind Typography styles the HTML that Markdown produces, which is the one
  place utility classes cannot reach — the markup is generated, not authored.
  `dark:prose-invert` is what carries the blog through the theme switch.
-->
<div
  class={cn(
    "prose prose-neutral max-w-none dark:prose-invert",
    "prose-headings:scroll-mt-24 prose-headings:font-semibold prose-headings:tracking-tight",
    "prose-a:text-primary prose-a:underline-offset-4",
    "prose-pre:rounded-lg prose-pre:border prose-pre:border-border",
    "prose-img:rounded-lg",
    className
  )}
>
  <slot />
</div>

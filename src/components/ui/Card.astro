---
import { cn } from "@/lib/utils"

/** See Container.astro for why the prop is `tag` rather than `as`. */
interface Props {
  tag?: "div" | "article" | "li"
  class?: string
}

const { tag: Tag = "div", class: className } = Astro.props
---

<Tag
  class={cn(
    "rounded-xl border border-border bg-card p-6 text-card-foreground",
    className
  )}
>
  <slot />
</Tag>

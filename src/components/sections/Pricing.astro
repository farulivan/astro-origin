---
import PricingToggle, {
  type PricingTier,
} from "@/components/islands/PricingToggle"
import Container from "@/components/ui/Container.astro"
import type { Locale } from "@/content/schemas"
import { useTranslations } from "@/i18n/utils"

interface Props {
  lang: Locale
  tiers: readonly PricingTier[]
}

const { lang, tiers } = Astro.props
const t = useTranslations(lang)
---

<Container tag="section" id="pricing" class="py-16 text-center sm:py-24">
  <div class="mx-auto max-w-2xl">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      {t("pricing.title")}
    </h2>
    <p class="text-muted-foreground mt-4 text-pretty">
      {t("pricing.subtitle")}
    </p>
  </div>

  <div class="mt-12 text-left">
    {
      /*
      client:visible, not client:load — the pricing table renders to static
      HTML at build time, so it is in the source for crawlers and readable
      with JavaScript disabled. The React runtime is fetched only if someone
      actually scrolls this far.
    */
    }
    <PricingToggle
      client:visible
      tiers={tiers}
      labels={{
        monthly: t("pricing.monthly"),
        annual: t("pricing.annual"),
        perMonth: t("pricing.perMonth"),
        billedAnnually: t("pricing.billedAnnually"),
        free: t("pricing.free"),
        featured: t("pricing.featured"),
        billingToggle: t("pricing.billingToggle"),
      }}
    />
  </div>
</Container>

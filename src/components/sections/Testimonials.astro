---
import Card from "@/components/ui/Card.astro"
import Section from "@/components/ui/Section.astro"
import { siteConfig } from "@/config/site"
import type { Locale } from "@/content/schemas"
import { useTranslations } from "@/i18n/utils"

export interface TestimonialItem {
  author: string
  role: string
  quote: string
}

interface Props {
  lang: Locale
  items: readonly TestimonialItem[]
}

const { lang, items } = Astro.props
const t = useTranslations(lang)
---

<Section>
  <h2
    class="max-w-[20ch] text-3xl font-semibold tracking-[-0.02em] text-balance sm:text-4xl"
  >
    {t("testimonials.title")}
  </h2>
  <p class="text-muted-foreground mt-4 max-w-xl text-pretty">
    {t("testimonials.subtitle", { name: siteConfig.name })}
  </p>

  <ul class="mt-12 grid gap-4 md:grid-cols-3">
    {
      items.map((item) => (
        <Card tag="li" class="flex flex-col">
          <blockquote class="flex-1 leading-relaxed text-pretty">
            “{item.quote}”
          </blockquote>
          <footer class="mt-6 font-mono text-xs tracking-[0.08em] uppercase">
            <div>{item.author}</div>
            <div class="text-muted-foreground mt-1">{item.role}</div>
          </footer>
        </Card>
      ))
    }
  </ul>
</Section>

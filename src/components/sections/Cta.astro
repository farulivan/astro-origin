---
import Button from "@/components/ui/Button.astro"
import Icon from "@/components/ui/Icon.astro"
import Section from "@/components/ui/Section.astro"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"

interface Props {
  lang: Locale
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<Section space="lg">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div>
      <h2
        class="max-w-[18ch] text-3xl font-semibold tracking-[-0.02em] text-balance sm:text-4xl"
      >
        {t("cta.title")}
      </h2>
      <p class="text-muted-foreground mt-4 max-w-md text-pretty">
        {t("cta.subtitle")}
      </p>
    </div>

    <Button
      href={localizePath("/#pricing", lang)}
      size="lg"
      class="group shrink-0 self-start md:self-auto"
    >
      {t("cta.button")}
      <Icon
        name="arrowRight"
        class="size-4 transition-transform group-hover:translate-x-0.5"
      />
    </Button>
  </div>
</Section>

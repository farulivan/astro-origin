---
import Icon from "@/components/ui/Icon.astro"
import Section from "@/components/ui/Section.astro"
import type { Locale } from "@/content/schemas"
import { useTranslations } from "@/i18n/utils"

export interface FaqItem {
  question: string
  answer: string
}

interface Props {
  lang: Locale
  items: readonly FaqItem[]
}

const { lang, items } = Astro.props
const t = useTranslations(lang)
---

<Section id="faq">
  <h2
    class="max-w-[20ch] text-3xl font-semibold tracking-[-0.02em] text-balance sm:text-4xl"
  >
    {t("faq.title")}
  </h2>
  <p class="text-muted-foreground mt-4 max-w-xl text-pretty">
    {t("faq.subtitle")}
  </p>

  {
    /*
    Native <details>/<summary>: keyboard support, screen-reader semantics and
    find-in-page all work with no JavaScript. An accordion is the classic case
    of a component people reach for a library to build, and shouldn't.
  */
  }
  <div class="divide-border border-border mt-12 max-w-3xl divide-y border-t">
    {
      items.map((item) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium marker:content-none">
            {item.question}
            <Icon
              name="chevronRight"
              class="text-muted-foreground size-4 shrink-0 transition-transform group-open:rotate-90"
            />
          </summary>
          <p class="text-muted-foreground pb-5 text-pretty">{item.answer}</p>
        </details>
      ))
    }
  </div>
</Section>

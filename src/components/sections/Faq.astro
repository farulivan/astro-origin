---
import Container from "@/components/ui/Container.astro"
import Icon from "@/components/ui/Icon.astro"
import type { Locale } from "@/content/schemas"
import { useTranslations } from "@/i18n/utils"

export interface FaqItem {
  question: string
  answer: string
}

interface Props {
  lang: Locale
  items: readonly FaqItem[]
}

const { lang, items } = Astro.props
const t = useTranslations(lang)
---

<Container tag="section" id="faq" class="py-16 sm:py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      {t("faq.title")}
    </h2>
    <p class="text-muted-foreground mt-4 text-pretty">{t("faq.subtitle")}</p>
  </div>

  {
    /*
    Native <details>/<summary>: keyboard support, screen-reader semantics and
    find-in-page all work with no JavaScript. An accordion is the classic case
    of a component people reach for a library to build, and shouldn't.
  */
  }
  <div
    class="divide-border border-border mx-auto mt-12 max-w-3xl divide-y border-y"
  >
    {
      items.map((item) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-medium marker:content-none">
            {item.question}
            <Icon
              name="chevronRight"
              class="text-muted-foreground size-4 shrink-0 transition-transform group-open:rotate-90"
            />
          </summary>
          <p class="text-muted-foreground pb-5 text-sm text-pretty">
            {item.answer}
          </p>
        </details>
      ))
    }
  </div>
</Container>

---
import type { PostListItem } from "@/content/queries"
import type { Locale } from "@/content/schemas"
import { useTranslations } from "@/i18n/utils"
import { formatDateShort, toDateAttribute } from "@/lib/format"
import { slugify } from "@/lib/slugify"

interface Props {
  lang: Locale
  posts: readonly PostListItem[]
  /** Builds a post URL; supplied by the page so this stays route-agnostic. */
  hrefFor: (slug: string) => string
  /** Builds a tag URL. Omit it and tags render as plain metadata. */
  tagHrefFor?: ((slug: string) => string) | undefined
}

const { lang, posts, hrefFor, tagHrefFor } = Astro.props
const t = useTranslations(lang)
---

{
  posts.length === 0 ? (
    <p class="text-muted-foreground border-border border-t py-16">
      {t("blog.empty")}
    </p>
  ) : (
    <ul class="divide-border border-border divide-y border-t">
      {posts.map((post) => (
        <li class="group relative py-8">
          <div class="text-muted-foreground flex items-center gap-2 font-mono text-xs tracking-[0.08em] uppercase">
            <time datetime={toDateAttribute(post.date)}>
              {formatDateShort(post.date, lang)}
            </time>
            {post.minutesRead !== undefined && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  {t("blog.readingTime", { minutes: post.minutesRead })}
                </span>
              </>
            )}
          </div>

          <h2 class="mt-3 text-xl font-medium tracking-[-0.015em]">
            {/* The overlay makes the whole row clickable while the anchor
                stays on the title, so the link text is meaningful out of
                context. Anything interactive added inside a row from here on
                needs `relative z-10` to stay above this overlay. */}
            <a
              href={hrefFor(post.slug)}
              class="group-hover:underline group-hover:underline-offset-4 after:absolute after:inset-0"
            >
              {post.title}
            </a>
          </h2>

          <p class="text-muted-foreground mt-2 max-w-2xl text-pretty">
            {post.description}
          </p>

          {post.tags.length > 0 && (
            <ul class="text-muted-foreground mt-4 flex flex-wrap gap-x-3 font-mono text-xs tracking-[0.08em] uppercase">
              {post.tags.map((tag) => (
                <li>
                  {tagHrefFor ? (
                    // `relative z-10` keeps this above the title link's
                    // full-bleed overlay; without it the tag cannot be clicked.
                    <a
                      href={tagHrefFor(slugify(tag))}
                      class="hover:text-foreground relative z-10 transition-colors"
                    >
                      {tag}
                    </a>
                  ) : (
                    tag
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  )
}

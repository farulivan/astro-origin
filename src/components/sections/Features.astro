---
import Card from "@/components/ui/Card.astro"
import Container from "@/components/ui/Container.astro"
import Icon from "@/components/ui/Icon.astro"
import type { FeatureIconName, Locale } from "@/content/schemas"
import { useTranslations } from "@/i18n/utils"

/**
 * Props in, HTML out. The page queries the collection and passes the result
 * down; this component never calls getCollection itself, which is what keeps
 * it renderable in a test without a build.
 */
export interface FeatureItem {
  title: string
  description: string
  icon: FeatureIconName
}

interface Props {
  lang: Locale
  items: readonly FeatureItem[]
}

const { lang, items } = Astro.props
const t = useTranslations(lang)
---

<Container tag="section" id="features" class="py-16 sm:py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
      {t("features.title")}
    </h2>
    <p class="text-muted-foreground mt-4 text-pretty">
      {t("features.subtitle")}
    </p>
  </div>

  <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item) => (
        <Card tag="li">
          <span
            class="bg-accent text-primary mb-4 flex size-9 items-center justify-center rounded-lg"
            aria-hidden="true"
          >
            <Icon name={item.icon} class="size-4.5" />
          </span>
          <h3 class="font-medium">{item.title}</h3>
          <p class="text-muted-foreground mt-2 text-sm">{item.description}</p>
        </Card>
      ))
    }
  </ul>
</Container>

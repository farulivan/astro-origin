---
import Icon from "@/components/ui/Icon.astro"
import Section from "@/components/ui/Section.astro"
import type { FeatureIconName, Locale } from "@/content/schemas"
import { useTranslations } from "@/i18n/utils"

/**
 * Props in, HTML out. The page queries the collection and passes the result
 * down; this component never calls getCollection itself, which is what keeps
 * it renderable in a test without a build.
 */
export interface FeatureItem {
  title: string
  description: string
  icon: FeatureIconName
}

interface Props {
  lang: Locale
  items: readonly FeatureItem[]
}

const { lang, items } = Astro.props
const t = useTranslations(lang)
---

<Section label={t("waypoint.move")} id="features">
  <h2
    class="max-w-[20ch] text-3xl font-semibold tracking-[-0.02em] text-balance sm:text-4xl"
  >
    {t("features.title")}
  </h2>
  <p class="text-muted-foreground mt-4 max-w-xl text-pretty">
    {t("features.subtitle")}
  </p>

  {
    /*
    Ruled rows rather than a grid of boxes. Six bordered cards read as six
    competing objects; a shared rule reads as one list, which is what this is.
  */
  }
  <ul class="mt-12 grid gap-x-12 sm:grid-cols-2">
    {
      items.map((item) => (
        <li class="border-border border-t py-6">
          <div class="flex items-center gap-3">
            <Icon
              name={item.icon}
              class="text-primary size-4 shrink-0"
              aria-hidden="true"
            />
            <h3 class="font-medium">{item.title}</h3>
          </div>
          <p class="text-muted-foreground mt-2 text-sm text-pretty">
            {item.description}
          </p>
        </li>
      ))
    }
  </ul>
</Section>

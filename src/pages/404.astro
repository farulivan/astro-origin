---
/**
 * A single 404 for the whole site, at the root rather than per locale: a
 * static host serves one not-found page and cannot know the visitor's
 * language, so this one links to both.
 */
import Button from "@/components/ui/Button.astro"
import Container from "@/components/ui/Container.astro"
import { DEFAULT_LOCALE, LOCALES } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"

const t = useTranslations(DEFAULT_LOCALE)
---

<BaseLayout
  lang={DEFAULT_LOCALE}
  path="/404"
  title={t("notFound.title")}
  description={t("notFound.description")}
>
  <Container class="py-28 text-center">
    <p class="text-muted-foreground font-mono text-sm">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">
      {t("notFound.title")}
    </h1>
    <p class="text-muted-foreground mx-auto mt-4 max-w-md text-pretty">
      {t("notFound.description")}
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {
        LOCALES.map((locale) => {
          const localeT = useTranslations(locale)
          return (
            <Button
              href={localizePath("/", locale)}
              variant={locale === DEFAULT_LOCALE ? "primary" : "outline"}
              hreflang={locale}
            >
              {localeT("notFound.home")}
            </Button>
          )
        })
      }
    </div>
  </Container>
</BaseLayout>

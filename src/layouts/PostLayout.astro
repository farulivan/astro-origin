---
import { Image } from "astro:assets"

import Button from "@/components/ui/Button.astro"
import Section from "@/components/ui/Section.astro"
import Icon from "@/components/ui/Icon.astro"
import Prose from "@/components/ui/Prose.astro"
import type { Locale } from "@/content/schemas"
import { localizePath, useTranslations } from "@/i18n/utils"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { formatDate, resolvePostDate, toDateAttribute } from "@/lib/format"

interface Props {
  lang: Locale
  slug: string
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date | undefined
  /** Git-derived, injected by the Sätteri plugin; a fallback only. */
  lastModified?: string | undefined
  minutesRead?: number | undefined
  tags: readonly string[]
  hero?: { src: ImageMetadata; alt: string } | undefined
  /** True when this is the English article standing in for a missing translation. */
  isFallback: boolean
  availableLocales: readonly Locale[]
}

const {
  lang,
  slug,
  title,
  description,
  pubDate,
  updatedDate,
  lastModified,
  minutesRead,
  tags,
  hero,
  isFallback,
  availableLocales,
} = Astro.props

const t = useTranslations(lang)

// One helper decides which date wins; see the shallow-clone caveat there.
const displayed = resolvePostDate({ pubDate, updatedDate, lastModified })
---

<BaseLayout
  lang={lang}
  path={`/blog/${slug}`}
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={displayed.kind === "updated" ? displayed.date : undefined}
  tags={tags}
  availableLocales={availableLocales}
>
  <Section space="sm">
    <div class="max-w-2xl">
      <Button
        href={localizePath("/blog", lang)}
        variant="ghost"
        size="sm"
        class="text-muted-foreground mb-8 -ml-3"
      >
        <Icon name="chevronLeft" class="size-4" />
        {t("blog.backToBlog")}
      </Button>

      {
        isFallback && (
          <p
            role="status"
            class="border-border bg-accent/50 text-muted-foreground mb-8 rounded-lg border px-4 py-3 text-sm"
          >
            {t("blog.untranslated")}
          </p>
        )
      }

      <header class="mb-10">
        <h1 class="text-4xl font-semibold tracking-[-0.03em] text-balance">
          {title}
        </h1>

        <div
          class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs tracking-[0.08em] uppercase"
        >
          <time datetime={toDateAttribute(displayed.date)}>
            {
              t(
                displayed.kind === "updated"
                  ? "blog.updated"
                  : "blog.published",
                {
                  date: formatDate(displayed.date, lang),
                }
              )
            }
          </time>
          {
            minutesRead !== undefined && (
              <>
                <span aria-hidden="true">·</span>
                <span>{t("blog.readingTime", { minutes: minutesRead })}</span>
              </>
            )
          }
        </div>

        {
          tags.length > 0 && (
            <ul class="text-muted-foreground mt-4 flex flex-wrap gap-x-3 font-mono text-xs tracking-[0.08em] uppercase">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      {
        hero && (
          <Image
            src={hero.src}
            alt={hero.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 42rem, 100vw"
            class="border-border mb-10 rounded-xl border"
            loading="eager"
          />
        )
      }

      <Prose>
        <slot />
      </Prose>
    </div>
  </Section>
</BaseLayout>

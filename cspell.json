{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "import": ["@cspell/dict-id-id/cspell-ext.json"],
  "dictionaries": ["id-id", "indonesian-extra"],
  "words": [
    "Amara",
    "astro",
    "astrojs",
    "autorun",
    "clsx",
    "contentful",
    "cssvariable",
    "cva",
    "esbuild",
    "farulivan",
    "fontsource",
    "frontmatter",
    "Halden",
    "hreflang",
    "hrefs",
    "lhci",
    "libvips",
    "lighthouseci",
    "mdast",
    "noopener",
    "noreferrer",
    "Novak",
    "nums",
    "Okafor",
    "renderable",
    "resvg",
    "safelisted",
    "satteri",
    "Sätteri",
    "shadcn",
    "sitemap",
    "Sundara",
    "tabnabbing",
    "tailwindcss",
    "transpiles",
    "treemap",
    "unparseable",
    "unsupplied",
    "vitest",
    "wordmark",
    "xdefault"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    ".astro",
    "coverage",
    "stats.html",
    "pnpm-lock.yaml",
    "public/*.svg",
    ".vscode"
  ],
  "dictionaryDefinitions": [
    {
      "name": "indonesian-extra",
      "path": "./cspell-id.txt",
      "description": "Affixed Indonesian forms missing from @cspell/dict-id-id."
    }
  ]
}
